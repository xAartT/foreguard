# Gerado normalmente por `foreguard install` (python3 scripts/install.py).

# Onde gravar os logs: database (Postgres do Foreguard) | client (a aplicação armazena)
LOG_STORAGE=client
# Obrigatória só com LOG_STORAGE=database
DATABASE_URL=postgresql+psycopg2://foreguard:senha@localhost:5432/foreguard

# Chave compartilhada com o middleware (header X-Foreguard-Key), mínimo 32 caracteres
FOREGUARD_API_KEY=troque-por-uma-chave-gerada-pelo-instalador

API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

THRESHOLD_MEDIUM=3.0
THRESHOLD_HIGH=6.0
THRESHOLD_CRITICAL=8.0

# Tamanho máximo (bytes) do corpo de POST /v1/analyze
MAX_REQUEST_BYTES=1048576
# Campos extras a mascarar no raw_request gravado (lista JSON)
MASK_FIELDS=[]

ML_MODEL_PATH=models/foreguard.pkl
# Vazio desliga o log em arquivo
LOG_DIR=logs
